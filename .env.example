# Team identity
BASE_TEAM_CITY=San Marcos
BASE_TEAM_NAME=Bobcats
BASE_TEAM_FULL_NAME=Texas State Bobcats
BASE_ORGANIZATION=Texas State Baseball
BASE_TEAM_ABBR=TXST
BASE_TEAM_DATA_CODE=TEX_BOB
# Regex used to recognize the team in BatterTeam and PitcherTeam columns.
BASE_TEAM_DATA_PATTERN=TEX_BOB|Texas State|Texas St\.|TXST
BASE_TEAM_SCOPE_ONLY=true

# College deployments normally use the local roster and schedule below.
# Enable this optional adapter only if the team exists in MLB's Stats API.
BASE_STATS_API_ENABLED=false
# BASE_MLB_TEAM_ID=1234
# BASE_LEAGUE_ID=567
# BASE_SPORT_ID=21
BASE_LEAGUE_NAME=Sun Belt Conference
BASE_SEASON=2026
BASE_SEASON_LABEL=2026 College Season
BASE_ROSTER_LABEL=2027 Texas State roster
BASE_COMPETITION_LEVEL=NCAA Division I
BASE_SCHEDULE_TIMEZONE=America/Chicago
BASE_MAX_UPLOAD_MB=100
# Optional; disabled by default so startup never depends on Google Fonts.
BASE_DOWNLOAD_REPORT_FONTS=false

# Brand colors and files served from the project's www directory.
BASE_PRIMARY_COLOR=#501214
BASE_SECONDARY_COLOR=#FFFFFF
BASE_ACCENT_COLOR=#D7BD8A
BASE_BACKGROUND_COLOR=#F7F3EC
BASE_TEAM_LOGO=TXST_SuperCat.webp
BASE_PRIMARY_LOGO=TXST_Primary.jpg
BASE_SECONDARY_LOGO=TXST_Secondary.png
BASE_SUPERCAT_LOGO=TXST_SuperCat.webp
BASE_CONFERENCE_LOGO=pac12logo.webp
BASE_SCOREBOARD_LOGO=TXST_Secondary.png
BASE_ANALYTICS_HUB_IMAGE=TXST_Primary.jpg
BASE_TEAM_REPORT_LOGO_URL=https://www.ncaa.com/sites/default/files/images/logos/schools/bgd/texas-st.svg
BASE_LEADERBOARDS_LOGO=TXST_SuperCat.webp

# Data and model sources
# One staged national master builds the shared runtime. Do not deploy app-local
# copies of this file alongside the runtime after cutover.
BASE_DATA_SOURCE_CONTRACT_FILE=config/baseball_data_sources.json
BASE_NCAA_D1_MASTER_FILE=/base-data/ncaa-d1/2026/master.parquet
BASE_NCAA_D1_DEFENSE_FILE=/base-data/ncaa-d1/2026/defense-alignment.parquet
BASE_TEAM_SUPPLEMENT_DATASET_DIR=/base-data/supplements/texas-state-pitches
# Writable directory used by the integrated Opponent Scouting file selector
# and optional TrackMan FTP imports.
BASE_SCOUTING_DATA_DIR=/base-data/app_state/scouting
# Opponent Scouting queries this existing season file for selected players.
# Optional override; auto-detection also checks the configured NCAA master.
BASE_SCOUTING_SEASON_FILE=/base-data/College26.parquet
# TRACKMAN_FTP_HOST=ftp.example.com
# TRACKMAN_FTP_USER=
# TRACKMAN_FTP_PASS=
# TRACKMAN_FTP_BASE=v3
# Query-on-demand runtime data in the attached private BASE bucket.
BASE_RUNTIME_ROOT=/base-data/derived2026
BASE_SEASON_DATA_FILE=/base-data/derived2026/teams/TEX_BOB.parquet
BASE_PITCHER_DATASET_DIR=/base-data/derived2026/pitchers
BASE_PITCHER_CATALOG_FILE=/base-data/derived2026/catalogs/pitchers.parquet
BASE_HITTER_CATALOG_FILE=/base-data/derived2026/catalogs/hitters.parquet
BASE_CATCHER_FRAMING_REFERENCE_FILE=/base-data/derived2026/reference/d1_catcher_framing_metrics.csv
BASE_HITTER_CATALOG_CACHE_FILE=/base-data/app_state/hitter-catalog.rds
BASE_CAPE_DATA_FILE=/base-data/CapeCod26.parquet
BASE_BREWSTUFF_MODEL_FILE=/base-data/models/brewstuff.model
BASE_SCOUT_MODELS_FILE=/base-data/models/pitch_models.rds
BASE_PITCHER_STUFF_MODEL_FILE=/base-data/models/Stuff+2.rds
BASE_PITCHER_LOCATION_MODEL_FILE=/base-data/models/location_plus_model.rds
BASE_PITCHER_LEAGUE_STATS_FILE=/base-data/models/NEW_LeagueStats2.rds
BASE_PITCHER_LOCATION_LEAGUE_STATS_FILE=/base-data/models/location_plus_league_stats_pitcher.rds
BASE_XWGRID_FILE=/base-data/models/xwoba_grid.rds
BASE_NCAA_COLORS_FILE=data/reference/NcaaColors.csv
BASE_PERCENTILE_TABLE_FILE=data/reference/percentile_table.csv
BASE_LEFT_BATTER_IMAGE_FILE=www/reference/left_batter.png
BASE_RIGHT_BATTER_IMAGE_FILE=www/reference/right_batter.png
# Optional pitcher metadata: tm_name, team_abbr, height (decimal feet), set.
BASE_PLAYER_HEIGHTS_FILE=data/reference/College26Heights.csv
# Optional CSV fallback with Name, Pos, Number, Bats, Throws, and pos_type.
BASE_ROSTER_FILE=config/texas_state_roster_2027.csv
# Optional local schedule. This is the primary college schedule source.
BASE_SCHEDULE_FILE=config/texas_state_schedule_2027.csv
