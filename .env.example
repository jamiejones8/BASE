# Team identity
BASE_TEAM_CITY=San Marcos
BASE_TEAM_NAME=Bobcats
BASE_TEAM_FULL_NAME=Texas State Bobcats
BASE_ORGANIZATION=Texas State Baseball
BASE_TEAM_ABBR=TXST
BASE_TEAM_DATA_CODE=TEX_BOB
# Regex used to recognize the team in BatterTeam and PitcherTeam columns.
BASE_TEAM_DATA_PATTERN=TEX_BOB|Texas State|Texas St\.|TXST
BASE_TEAM_SCOPE_ONLY=true

# College deployments normally use the local roster and schedule below.
# Enable this optional adapter only if the team exists in MLB's Stats API.
BASE_STATS_API_ENABLED=false
# BASE_MLB_TEAM_ID=1234
# BASE_LEAGUE_ID=567
# BASE_SPORT_ID=21
BASE_LEAGUE_NAME=Sun Belt Conference
BASE_SEASON=2026
BASE_SEASON_LABEL=2026 College Season
BASE_ROSTER_LABEL=2026 Texas State roster
BASE_COMPETITION_LEVEL=NCAA Division I
BASE_SCHEDULE_TIMEZONE=America/Chicago

# Brand colors and files served from the project's www directory.
BASE_PRIMARY_COLOR=#501214
BASE_SECONDARY_COLOR=#FFFFFF
BASE_ACCENT_COLOR=#D7BD8A
BASE_BACKGROUND_COLOR=#F7F3EC
BASE_TEAM_LOGO=TXST_SuperCat.webp
BASE_PRIMARY_LOGO=TXST_Primary.jpg
BASE_SECONDARY_LOGO=TXST_Secondary.png
BASE_SUPERCAT_LOGO=TXST_SuperCat.webp
BASE_SCOREBOARD_LOGO=TXST_Secondary.png
BASE_ANALYTICS_HUB_IMAGE=TXST_Primary.jpg
BASE_TEAM_REPORT_LOGO_URL=https://www.ncaa.com/sites/default/files/images/logos/schools/bgd/texas-st.svg
BASE_LEADERBOARDS_LOGO=TXST_SuperCat.webp

# Data and model sources
# Query-on-demand runtime data in the attached private BASE bucket.
BASE_RUNTIME_ROOT=/base-data/derived2026
BASE_SEASON_DATA_FILE=/base-data/derived2026/teams/TEX_BOB.parquet
BASE_PITCHER_DATASET_DIR=/base-data/derived2026/pitchers
BASE_PITCHER_CATALOG_FILE=/base-data/derived2026/catalogs/pitchers.parquet
BASE_HITTER_CATALOG_FILE=/base-data/derived2026/catalogs/hitters.parquet
BASE_HITTER_CATALOG_CACHE_FILE=/base-data/app_state/hitter-catalog.rds
# BASE_SWING_MODEL_REPO=organization/swing-decision-models
# The season-card source can be the same file as BASE_SEASON_DATA_FILE.
BASE_COLLEGE_DATA_FILE=/base-data/College26.parquet
BASE_CAPE_DATA_FILE=CapeCod26.parquet
# Optional pitcher metadata: tm_name, team_abbr, height (decimal feet), set.
BASE_PLAYER_HEIGHTS_FILE=PlayerHeights.csv
# Optional CSV fallback with Name, Pos, Number, Bats, Throws, and pos_type.
BASE_ROSTER_FILE=config/texas_state_roster_2026_reference.csv
# Optional local schedule. This is the primary college schedule source.
BASE_SCHEDULE_FILE=config/texas_state_schedule_2026.csv

# Optional write-back secret for acquisition-list updates only.
# write_token=hf_...
