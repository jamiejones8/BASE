!/WallyApps/PitchingApp/data/called_stuff_baseline.csv
!/WallyApps/PitchingApp/data/d1_pitch_metric_percentile_reference.csv
!/WallyApps/PitchingApp/data/player_heights.csv
!/WallyApps/PitchingApp/data/xrv_metrics.csv
/WallyApps/PitchingApp/models/
/WallyApps/DefenseApp/data/*
