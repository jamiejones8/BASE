# WallyApps is an imported migration working copy. Keep its source visible,
# but never version local sessions, deployment metadata, scraped browser state,
# private baseball data, or unreviewed model artifacts.
/WallyApps/**/.DS_Store
/WallyApps/**/.RData
/WallyApps/**/.Rhistory
/WallyApps/**/.Rapp.history
/WallyApps/**/.Renviron
/WallyApps/**/.Rproj.user/
/WallyApps/**/Rplots.pdf
/WallyApps/**/rsconnect/
/WallyApps/**/.browser-profile*/
/WallyApps/**/__pycache__/
/WallyApps/**/*.pyc
/WallyApps/**/catboost_info/
/WallyApps/**/tmp/
/WallyApps/**/*.parquet
/WallyApps/**/*.pkl
/WallyApps/JucoStatsApp/data/raw_njcaa/
/WallyApps/JucoStatsApp/data/debug_njcaa/
/WallyApps/JucoStatsApp/data/juco_player_stats_latest.csv
/WallyApps/JucoStatsApp/data/d1_hitting_metric_percentile_reference.csv
/WallyApps/JucoStatsApp/data/d1_pitch_metric_percentile_reference.csv
/WallyApps/D1 Files/
!/WallyApps/HittingApp/data/
